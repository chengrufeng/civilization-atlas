      "caption": "194 年，徐州牧陶谦临终让位，刘备第一次拥有了自己的地盘。"
    },
    {
      "t": 25.98,
      "year": 196,
      "place": "许昌",
      "step": 2,
      "caption": "好景不长，吕布偷袭徐州。刘备败走，被迫投奔曹操，被当作英雄，也被当作隐患。"
    },
    {
      "t": 34.66,
      "year": 199,
      "place": "徐州",
      "step": 3,
      "caption": "199 年，借讨袁之名脱身，占下邳反曹。却再度兵败，关羽被擒。"
    },
    {
      "t": 41.97,
      "year": 200,
      "place": "邺城",
      "step": 4,
      "caption": "投奔袁绍，又南走荆州刘表，被安置在小县新野，一守就是七年。"
    },
    {
      "t": 48.82,
      "year": 207,
      "place": "隆中",
      "step": 5,
      "caption": "207 年冬，三顾茅庐。27 岁的诸葛亮一席隆中对，让 47 岁的刘备第一次看清了天下棋局。"
    },
    {
      "t": 58.31,
      "year": 208,
      "place": "江夏",
      "step": 6,
      "caption": "208 年，曹操南下。长坂坡上抛妻弃子，败走江夏。"
    },
    {
      "t": 64.21,
      "year": 208,
      "place": "江夏",
      "step": 7,
      "caption": "赤壁一把大火，烧出了三国鼎立，也烧出了刘备的转机。"
    },
    {
      "t": 69.62,
      "year": 209,
      "place": "江陵",
      "step": 8,
      "caption": "借荆州、据南部四郡，他终于在 48 岁这年，有了争天下的根基。"
    },
    {
      "t": 76.4,
      "year": 214,
      "place": "成都",
      "step": 9,
      "caption": "214 年，取益州，入主成都。隆中对的第二步，落子成局。"
    },
    {
